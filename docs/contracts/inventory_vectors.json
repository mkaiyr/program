{
  "about": "Сценарии для проверки складской логики. Одни и те же входы и ожидаемые результаты обязаны выдавать эталонная модель (inventory_model.py) и будущие SQL-функции. Названия продуктов и блюд условные: это структура, а не рецептуры кафе. Количества — числа в единице измерения склада продукта.",
  "units": [
    {
      "qty": "1.5",
      "from": "кг",
      "to": "г",
      "expect": "1500.000"
    },
    {
      "qty": "250",
      "from": "мл",
      "to": "л",
      "expect": "0.250"
    },
    {
      "qty": "3",
      "from": "шт",
      "to": "шт.",
      "expect": "3.000"
    },
    {
      "qty": "0.0004",
      "from": "кг",
      "to": "г",
      "expect": "0.400"
    },
    {
      "qty": "1",
      "from": "кг",
      "to": "шт",
      "error": "UNIT_MISMATCH"
    },
    {
      "qty": "1",
      "from": "л",
      "to": "г",
      "error": "UNIT_MISMATCH"
    },
    {
      "qty": "1",
      "from": "фунт",
      "to": "г",
      "error": "UNKNOWN_UNIT"
    }
  ],
