-- ЧЕРНОВИК ДЛЯ РЕВЬЮ. НЕ ПРИМЕНЯТЬ. Не выполнялся и не проверен на синтаксис. После согласования переносится в sql/19_stock_core.sql и проверяется на cashier_catalog_dev.
-- =====================================================================
-- 19. Склад: продукты, журнал движений (только добавление), поставщики
-- Зависимости: 01–16, 18 (триггер updated_at). Остаток продукта меняет ТОЛЬКО функция _stock_post (пишет движение и обновляет остаток в одной операции);
-- check (stock >= 0) делает отрицательный остаток невозможным на уровне БД. Клиенты не получают прав на таблицы.
-- =====================================================================
begin;

create table if not exists public.stock_products (
  id             bigint generated always as identity primary key,
  name           text not null check (name = btrim(name) and length(name) between 1 and 100),
  category       text not null default 'Прочее' check (length(btrim(category)) between 1 and 50),
  unit           text not null check (unit in ('кг', 'г', 'л', 'мл', 'шт.')),   -- единица ХРАНЕНИЯ остатка
  purchase_price numeric(12, 2) check (purchase_price >= 0),                    -- цена за единицу хранения; редактирует только администратор
  min_stock      numeric(14, 3) not null default 0 check (min_stock >= 0),
  stock          numeric(14, 3) not null default 0 check (stock >= 0),
  active         boolean not null default true,
  created_at     timestamptz not null default now(),
  updated_at     timestamptz not null default now()
);
create unique index if not exists stock_products_name_key on public.stock_products (lower(name));
drop trigger if exists stock_products_touch on public.stock_products;
create trigger stock_products_touch before update on public.stock_products for each row execute function public._touch_updated_at();

create table if not exists public.stock_movements (
  id          bigint generated always as identity primary key,
  product_id  bigint not null references public.stock_products (id) on delete restrict,
  delta       numeric(14, 3) not null check (delta <> 0),
  kind        text not null check (kind in ('receipt', 'sale', 'cancel', 'return', 'loss', 'count')),
  order_id    bigint references public.orders (id) on delete restrict,
  ref_id      bigint,                    -- поступление / инвентаризация / списание потерь
  reason      text,
  actor       uuid references auth.users (id) on delete set null,
  created_at  timestamptz not null default now()
);
create index if not exists stock_movements_product_idx on public.stock_movements (product_id, created_at desc);
create index if not exists stock_movements_order_idx   on public.stock_movements (order_id) where order_id is not null;

-- Журнал нельзя менять и удалять (как order_purge_log в 10)
create or replace function public._stock_movements_readonly() returns trigger
language plpgsql set search_path = '' as $$
begin raise exception using errcode = '42501', message = 'LEDGER_IS_APPEND_ONLY'; end;
$$;
drop trigger if exists stock_movements_no_change on public.stock_movements;
create trigger stock_movements_no_change before update or delete on public.stock_movements for each row execute function public._stock_movements_readonly();
drop trigger if exists stock_movements_no_truncate on public.stock_movements;
create trigger stock_movements_no_truncate before truncate on public.stock_movements for each statement execute function public._stock_movements_readonly();

create table if not exists public.suppliers (
  id         bigint generated always as identity primary key,
  name       text not null check (name = btrim(name) and length(name) between 1 and 100),
  contacts   text not null default '' check (length(contacts) <= 300),
  comment    text not null default '' check (length(comment) <= 500),
  active     boolean not null default true,
  created_at timestamptz not null default now()
);
create unique index if not exists suppliers_name_key on public.suppliers (lower(name));

alter table public.stock_products  enable row level security;
alter table public.stock_movements enable row level security;
alter table public.suppliers       enable row level security;

-- Коэффициент единицы к базовой (г, мл, шт.) и величина; разные величины конвертировать нельзя
create or replace function public._unit_base(p_unit text, out dim text, out factor numeric)
language sql immutable set search_path = '' as $$
  select case p_unit when 'кг' then 'mass' when 'г' then 'mass' when 'л' then 'volume' when 'мл' then 'volume' when 'шт.' then 'count' when 'шт' then 'count' end,
         case p_unit when 'кг' then 1000 when 'г' then 1 when 'л' then 1000 when 'мл' then 1 when 'шт.' then 1 when 'шт' then 1 end::numeric;
$$;

create or replace function public.convert_qty(p_qty numeric, p_from text, p_to text) returns numeric
language plpgsql immutable set search_path = '' as $$
declare a record; b record;
begin
  select * into a from public._unit_base(p_from); select * into b from public._unit_base(p_to);
  if a.dim is null or b.dim is null then raise exception using errcode = '22023', message = 'UNKNOWN_UNIT'; end if;
  if a.dim <> b.dim then raise exception using errcode = '22023', message = 'UNIT_MISMATCH'; end if;
  return round(p_qty * a.factor / b.factor, 3);
end;
$$;

-- ЕДИНСТВЕННОЕ место изменения остатка. Остаток блокируется строкой; нехватка — INSUFFICIENT_STOCK с понятным detail (имя, нужно, есть).
create or replace function public._stock_post(p_product bigint, p_delta numeric, p_kind text, p_order bigint, p_ref bigint, p_reason text)
returns void language plpgsql security definer set search_path = '' as $$
declare v_name text; v_unit text; v_have numeric;
begin
  -- строка продукта блокируется до проверки: два одновременных заказа не пройдут оба «по старому остатку»
  select name, unit, stock into v_name, v_unit, v_have from public.stock_products where id = p_product for update;
  if not found then raise exception using errcode = 'P0002', message = 'PRODUCT_NOT_FOUND'; end if;
  if v_have + p_delta < 0 then
    raise exception using errcode = 'P0001', message = 'INSUFFICIENT_STOCK',
          detail = format('%s: нужно %s %s, есть %s %s', v_name, (-p_delta)::text, v_unit, v_have::text, v_unit);
  end if;
  update public.stock_products set stock = v_have + p_delta where id = p_product;
  insert into public.stock_movements (product_id, delta, kind, order_id, ref_id, reason, actor)
  values (p_product, p_delta, p_kind, p_order, p_ref, p_reason, auth.uid());
end;
$$;
-- Вызывающие функции обязаны блокировать несколько продуктов в одном порядке (по id), чтобы не было взаимных блокировок.

-- ---------- Функции администратора (кассиру закупочные цены и остатки не редактировать) ----------
create or replace function public.admin_save_stock_product(p_id bigint, p_data jsonb)
returns jsonb language plpgsql security definer set search_path = '' as $$
declare v_id bigint;
begin
  if not public.is_active_admin() then raise exception using errcode = '42501', message = 'NOT_ALLOWED'; end if;
  if p_id is null then
    insert into public.stock_products (name, category, unit, purchase_price, min_stock)
    values (btrim(p_data ->> 'name'), coalesce(nullif(btrim(p_data ->> 'category'), ''), 'Прочее'), p_data ->> 'unit',
            nullif(p_data ->> 'purchase_price', '')::numeric, coalesce((p_data ->> 'min_stock')::numeric, 0)) returning id into v_id;
  else
    -- единицу хранения менять нельзя, если по продукту уже есть движения (иначе журнал потеряет смысл)
    if p_data ? 'unit' and exists (select 1 from public.stock_movements where product_id = p_id)
       and (select unit from public.stock_products where id = p_id) <> p_data ->> 'unit' then
      raise exception using errcode = 'P0001', message = 'UNIT_LOCKED';
    end if;
    update public.stock_products set name = coalesce(btrim(p_data ->> 'name'), name), category = coalesce(nullif(btrim(p_data ->> 'category'), ''), category),
           unit = coalesce(p_data ->> 'unit', unit), purchase_price = case when p_data ? 'purchase_price' then nullif(p_data ->> 'purchase_price', '')::numeric else purchase_price end,
           min_stock = coalesce((p_data ->> 'min_stock')::numeric, min_stock), active = coalesce((p_data ->> 'active')::boolean, active)
     where id = p_id returning id into v_id;
    if v_id is null then raise exception using errcode = 'P0002', message = 'PRODUCT_NOT_FOUND'; end if;
  end if;
  return jsonb_build_object('product_id', v_id);
end;
$$;

create or replace function public.stock_products_list(p_only_low boolean default false)
returns jsonb language plpgsql stable security definer set search_path = '' as $$
begin
  if not public.is_active_admin() then raise exception using errcode = '42501', message = 'NOT_ALLOWED'; end if;
  return (select coalesce(jsonb_agg(jsonb_build_object('id', p.id, 'name', p.name, 'category', p.category, 'unit', p.unit, 'purchase_price', p.purchase_price,
           'min_stock', p.min_stock, 'stock', p.stock, 'active', p.active, 'low', p.stock <= p.min_stock) order by p.name), '[]'::jsonb)
            from public.stock_products p where not p_only_low or p.stock <= p.min_stock);
end;
$$;

create or replace function public.stock_product_history(p_product bigint, p_limit integer default 200)
returns jsonb language plpgsql stable security definer set search_path = '' as $$
begin
  if not public.is_active_admin() then raise exception using errcode = '42501', message = 'NOT_ALLOWED'; end if;
  return (select coalesce(jsonb_agg(x order by x.id desc), '[]'::jsonb) from (
            select m.id, m.created_at, m.delta, m.kind, m.order_id, m.ref_id, m.reason, pr.full_name as actor_name
              from public.stock_movements m left join public.profiles pr on pr.id = m.actor
             where m.product_id = p_product order by m.id desc limit least(coalesce(p_limit, 200), 1000)) x);
end;
$$;

create or replace function public.admin_save_supplier(p_id bigint, p_data jsonb)
returns jsonb language plpgsql security definer set search_path = '' as $$
declare v_id bigint;
begin
  if not public.is_active_admin() then raise exception using errcode = '42501', message = 'NOT_ALLOWED'; end if;
  if p_id is null then
    insert into public.suppliers (name, contacts, comment) values (btrim(p_data ->> 'name'), coalesce(p_data ->> 'contacts', ''), coalesce(p_data ->> 'comment', '')) returning id into v_id;
  else
    update public.suppliers set name = coalesce(btrim(p_data ->> 'name'), name), contacts = coalesce(p_data ->> 'contacts', contacts),
           comment = coalesce(p_data ->> 'comment', comment), active = coalesce((p_data ->> 'active')::boolean, active) where id = p_id returning id into v_id;
    if v_id is null then raise exception using errcode = 'P0002', message = 'SUPPLIER_NOT_FOUND'; end if;
  end if;
  return jsonb_build_object('supplier_id', v_id);
end;
$$;

revoke all on function public.admin_save_stock_product(bigint, jsonb), public.stock_products_list(boolean), public.stock_product_history(bigint, integer),
                      public.admin_save_supplier(bigint, jsonb), public._stock_post(bigint, numeric, text, bigint, bigint, text) from public, anon;
grant execute on function public.admin_save_stock_product(bigint, jsonb), public.stock_products_list(boolean), public.stock_product_history(bigint, integer),
                          public.admin_save_supplier(bigint, jsonb) to authenticated;
-- _stock_post — внутренняя: прав у клиентов нет (вызывается из других функций SECURITY DEFINER).
commit;
