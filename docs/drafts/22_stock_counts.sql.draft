-- ЧЕРНОВИК ДЛЯ РЕВЬЮ. НЕ ПРИМЕНЯТЬ. Не выполнялся и не проверен на синтаксис.
-- =====================================================================
-- 22. Инвентаризация: расчётный остаток, фактический остаток, причина расхождения, подтверждение с корректирующим движением
-- Зависимости: 19. Остаток нельзя «просто переписать»: подтверждение пишет движение kind = 'count' (факт − текущий остаток на момент подтверждения).
-- =====================================================================
begin;

create table if not exists public.stock_counts (
  id                bigint generated always as identity primary key,
  client_request_id uuid not null unique,
  status            text not null default 'draft' check (status in ('draft', 'confirmed')),
  note              text not null default '' check (length(note) <= 500),
  created_by        uuid references auth.users (id) on delete set null,
  created_at        timestamptz not null default now(),
  confirmed_by      uuid references auth.users (id) on delete set null,
  confirmed_at      timestamptz,
  constraint stock_counts_confirmed_consistent check ((status = 'confirmed') = (confirmed_at is not null))
);
create table if not exists public.stock_count_lines (
  count_id   bigint not null references public.stock_counts (id) on delete cascade,
  product_id bigint not null references public.stock_products (id) on delete restrict,
  expected   numeric(14, 3) not null,                 -- расчётный остаток на момент создания
  actual     numeric(14, 3) check (actual >= 0),      -- фактический (вводится при пересчёте)
  reason     text,
  primary key (count_id, product_id)
);
alter table public.stock_counts      enable row level security;
alter table public.stock_count_lines enable row level security;

-- Создание: фиксирует расчётные остатки активных продуктов (повтор с тем же ключом возвращает документ)
create or replace function public.admin_create_count(p_request_id uuid, p_note text)
returns jsonb language plpgsql security definer set search_path = '' as $$
declare v_id bigint;
begin
  if not public.is_active_admin() then raise exception using errcode = '42501', message = 'NOT_ALLOWED'; end if;
  select id into v_id from public.stock_counts where client_request_id = p_request_id;
  if found then return jsonb_build_object('count_id', v_id, 'duplicate', true); end if;
  insert into public.stock_counts (client_request_id, note, created_by) values (p_request_id, coalesce(p_note, ''), auth.uid()) returning id into v_id;
  insert into public.stock_count_lines (count_id, product_id, expected) select v_id, p.id, p.stock from public.stock_products p where p.active;
  return jsonb_build_object('count_id', v_id, 'duplicate', false);
end;
$$;

create or replace function public.admin_set_count_line(p_count_id bigint, p_product_id bigint, p_actual numeric, p_reason text)
returns jsonb language plpgsql security definer set search_path = '' as $$
begin
  if not public.is_active_admin() then raise exception using errcode = '42501', message = 'NOT_ALLOWED'; end if;
  if p_actual is null or p_actual < 0 then raise exception using errcode = '22023', message = 'NEGATIVE_ACTUAL'; end if;
  update public.stock_count_lines l set actual = p_actual, reason = nullif(btrim(coalesce(p_reason, '')), '')
    from public.stock_counts c where l.count_id = p_count_id and l.product_id = p_product_id and c.id = l.count_id and c.status = 'draft';
  if not found then raise exception using errcode = 'P0002', message = 'COUNT_LINE_NOT_FOUND'; end if;
  return jsonb_build_object('count_id', p_count_id, 'product_id', p_product_id);
end;
$$;

-- Подтверждение: документ блокируется; повтор ничего не меняет; расхождение без причины запрещено; продукты — в порядке id
create or replace function public.admin_confirm_count(p_count_id bigint)
returns jsonb language plpgsql security definer set search_path = '' as $$
declare v_status text; r record; v_diff numeric; v_changed integer := 0;
begin
  if not public.is_active_admin() then raise exception using errcode = '42501', message = 'NOT_ALLOWED'; end if;
  select status into v_status from public.stock_counts where id = p_count_id for update;
  if not found then raise exception using errcode = 'P0002', message = 'COUNT_NOT_FOUND'; end if;
  if v_status = 'confirmed' then return jsonb_build_object('count_id', p_count_id, 'duplicate', true); end if;
  for r in select l.product_id, l.actual, l.reason from public.stock_count_lines l where l.count_id = p_count_id and l.actual is not null order by l.product_id loop
    select r.actual - p.stock into v_diff from public.stock_products p where p.id = r.product_id for update;
    if v_diff <> 0 then
      if r.reason is null then raise exception using errcode = 'P0001', message = 'REASON_REQUIRED', detail = r.product_id::text; end if;
      perform public._stock_post(r.product_id, v_diff, 'count', null, p_count_id, r.reason);
      v_changed := v_changed + 1;
    end if;
  end loop;
  update public.stock_counts set status = 'confirmed', confirmed_by = auth.uid(), confirmed_at = now() where id = p_count_id;
  return jsonb_build_object('count_id', p_count_id, 'duplicate', false, 'adjusted', v_changed);
end;
$$;

-- Отчёт: журнал сходится с остатками? (для администратора и SQL-проверок)
create or replace function public.stock_ledger_check()
returns jsonb language plpgsql stable security definer set search_path = '' as $$
begin
  if not public.is_active_admin() then raise exception using errcode = '42501', message = 'NOT_ALLOWED'; end if;
  return (select coalesce(jsonb_agg(jsonb_build_object('product_id', p.id, 'stock', p.stock, 'ledger', s.total)), '[]'::jsonb)
            from public.stock_products p join (select product_id, sum(delta) as total from public.stock_movements group by product_id) s on s.product_id = p.id
           where p.stock <> s.total);
end;
$$;
-- ВОПРОС РЕВЬЮ: у продуктов с начальным остатком без движения журнал не сойдётся. Начальные остатки вносить документом «инвентаризация», а не прямым update.

revoke all on function public.admin_create_count(uuid, text), public.admin_set_count_line(bigint, bigint, numeric, text), public.admin_confirm_count(bigint), public.stock_ledger_check() from public, anon;
grant execute on function public.admin_create_count(uuid, text), public.admin_set_count_line(bigint, bigint, numeric, text), public.admin_confirm_count(bigint), public.stock_ledger_check() to authenticated;
commit;
